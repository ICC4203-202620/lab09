# Copia este archivo como .env. Ninguna key se versiona: .env está en .gitignore.
#
# Un solo archivo sirve a los dos procesos: Vite lee de aquí las variables con
# prefijo VITE_ (y solo esas llegan al navegador), y el backend las lee con
# `uvicorn --env-file ../.env`.

# ---- Backend (backend/app). Estas keys nunca salen del servidor. ----
# Restringe esta key, en la consola de Google Cloud, a Geocoding API y
# Cloud Translation API.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# ---- Frontend. Esta key viaja dentro del bundle: cualquiera que abra la ----
# aplicación puede leerla. Lo que la protege es la restricción por referente
# HTTP (http://localhost:5173/*) y por API (Maps JavaScript API y Places API
# (New)) que se configura en la consola, no el secreto de su valor.
VITE_GOOGLE_MAPS_API_KEY=

# Los Advanced Markers necesitan un Map ID. DEMO_MAP_ID sirve para desarrollo;
# en producción, crea uno propio en Google Cloud > Map Management.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
