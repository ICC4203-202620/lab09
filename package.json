{
  "name": "lab09",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"vite\" \"yarn -s dev:api\"",
    "dev:web": "vite",
    "dev:api": "cd backend && .venv/bin/uvicorn app.main:app --reload --env-file ../.env",
    "setup:api": "cd backend && python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt",
    "test:api": "cd backend && .venv/bin/pytest -q",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "concurrently -k -n WEB,API -c cyan,magenta \"vite preview\" \"yarn -s dev:api\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.15.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "formik": "^2.4.9",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8",
    "use-local-storage-state": "^20.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/google.maps": "^3.66.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.3"
  }
}
